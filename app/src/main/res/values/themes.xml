<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EVE" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cyan</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="EveButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/cyan</item>
        <item name="strokeColor">@color/line</item>
    </style>
    <style name="EveField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/dim</item>
        <item name="android:backgroundTint">@color/line</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="EveLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>
